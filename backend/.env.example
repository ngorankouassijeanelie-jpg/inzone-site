# inZONE API — configuration production (copier vers .env, jamais commité)
INZONE_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
INZONE_CORS=https://votredomaine.ci
INZONE_URL=https://votredomaine.ci
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=inzone@africand.com
# Paiement Mobile Money / carte locale (CinetPay) — https://api-checkout.cinetpay.com
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
# Paiement carte internationale (Stripe) — clé secrète et secret de signature webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
